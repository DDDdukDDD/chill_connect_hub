# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/scratch/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# data/discovery_content.json (spots, quests) is tracked on purpose: committed snapshots are how
# imported spots reach the Vercel deploy (serverless writes go to /tmp and do not persist)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Staff accounts (password hashes) and the admin audit log are local runtime data, never committed
/data/staff_accounts.json
/data/audit_log.json
/data/google_places_usage.json
